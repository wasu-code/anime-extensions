<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="tachiyomi.extension" />

    <application android:icon="@mipmap/ic_launcher" android:allowBackup="false" android:label="${appName}">

        <!-- tachiyomix 1.6 -->
        <meta-data android:name="tachiyomix.name" android:value="${extName}" />
        <meta-data android:name="tachiyomix.contentWarning" android:value="${contentWarning}" />
        <meta-data android:name="tachiyomix.extensionLib" android:value="${extensionLib}" />
        <meta-data android:name="tachiyomi.extension.class" android:value="${extClass}" />

        <!-- Pre-1.6 flag, kept for hosts that do not read tachiyomix.contentWarning -->
        <meta-data android:name="tachiyomi.extension.nsfw" android:value="${nsfw}" />

    </application>

</manifest>
